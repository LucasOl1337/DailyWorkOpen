# Historical Sumário conversation dumps. Commit only the current day's file:
# git add -f data/sumarios/AAAA-MM-DD/conversas.json
# After merge/checkout, restore any locally deleted dumps from the previous
# revision onto the working tree and leave them untracked.
data/sumarios/**/conversas.json

