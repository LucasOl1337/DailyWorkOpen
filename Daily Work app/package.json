{
  "name": "dailywork",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "node --check electron/main.cjs && tsc --noEmit && vite build && node --test tests/inicializacao.test.cjs",
    "preview": "vite preview",
    "app": "npm run build && electron .",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "install:linux": "bash scripts/install-linux.sh",
    "install:agenda": "node scripts/install-agenda-linux.cjs",
    "agenda:parar": "node scripts/parar-agenda.cjs",
    "test": "node --test \"tests/**/*.test.cjs\""
  },
  "dependencies": {
    "@tldraw/assets": "4.5.12",
    "fast-json-stable-stringify": "^2.1.0",
    "playwright-core": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tldraw": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
