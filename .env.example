# Optional overrides. The app runs without these files.

# Isolated data directory (defaults to Daily Work app/data).
# DAILYWORK_DATA_DIR=

# Isolated Electron userData (credentials vault, window state).
# DAILYWORK_USER_DATA_DIR=

# Free tldraw boards (defaults to Daily Work app/sessoes).
# DAILYWORK_SESSOES_DIR=

# Personal knowledge + career workspace (defaults to ../LucasOL from the app).
# LUCASOL_DIR=
# LUCAS_KNOWLEDGE_DIR=

# Disable the local HTTP API (the Electron IPC still works).
# DAILYWORK_API_DISABLED=1
